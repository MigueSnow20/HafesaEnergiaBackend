# Origin of the NEW Spring service, not the Spring packaged in this legacy project.
PETROXPERT_MARKET_API_URL=http://127.0.0.1:8080
# Configure the same external secret in both Node and NEW Spring; no real value in Git.
PETROXPERT_MARKET_API_TOKEN=
PETROXPERT_MARKET_API_TIMEOUT_MS=5000
PORT=3000
SPRING_PORT=8081
LEGACY_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
# DATABASE_URL continues to be supplied externally or by the existing database.env.

# MARKET-REFRESH-001: both Spring services use these durations; Vue follows the response header.
MARKET_REFRESH=5s
MARKET_STALE_AFTER=20s
